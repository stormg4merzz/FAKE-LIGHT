{
  "schemaVersion": 1,
  "id": "lightningpop",
  "version": "${version}",
  "name": "Lightning pop by STORM",
  "description": "Spawns fake visual lightning on totem pops. Toggle with /light!",
  "authors": ["STORM"],
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.example.lightningpop.TotemLightningClient"
    ]
  },
  "mixins": [
    "lightningpop.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.16.0",
    "fabric-api": "*",
    "minecraft": "~1.21.11",
    "java": ">=21"
  }
}
